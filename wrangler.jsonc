{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink-ridgecast",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "60b772f33aa44788aeb7b5730e47f17a"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink-ridgecast-db",
      "database_id": "82421aa8-acf2-46fd-b570-8ea8a2de85df",
      "migrations_dir": "server/database/migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink-ridgecast"
    }
  ],
  "vars": {
    "NUXT_CF_ACCOUNT_ID": "1fad84633451c4018e7814715f6eae87",
    "NUXT_DATASET": "sink-ridgecast"
  }
}